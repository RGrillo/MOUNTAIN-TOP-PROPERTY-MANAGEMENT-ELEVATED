# Public site URL used for canonical links and social metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Enquiry delivery — configure at least one destination.
# 1) Email delivery through Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Mountain Top Website <enquiries@yourdomain.com>"

# 2) Or forward enquiries to any CRM / automation endpoint (Zapier, Make, n8n…)
ENQUIRY_WEBHOOK_URL=
